rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Diagnostic / Testing Collection ---
    function isValidTest(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.status is string && data.status.size() <= 50 &&
             data.message is string && data.message.size() <= 500 &&
             data.testedBy is string && data.testedBy.size() <= 128 &&
             data.createdAt is string && data.createdAt.size() <= 50;
    }

    match /test/{testId} {
      allow get, list: if true;
      allow create: if isValidId(testId) && isValidTest(incoming());
      allow update: if isValidId(testId) && isValidTest(incoming()) && incoming().id == existing().id;
      allow delete: if isValidId(testId);
    }

    // --- Leaderboard Collection ---
    function isValidLeaderboard(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.displayName is string && data.displayName.size() <= 40 &&
             data.wins is number && data.wins >= 0 &&
             data.losses is number && data.losses >= 0 &&
             data.goalsScored is number && data.goalsScored >= 0 &&
             data.winStreak is number && data.winStreak >= 0 &&
             data.highestStreak is number && data.highestStreak >= 0 &&
             data.updatedAt is string && data.updatedAt.size() <= 50;
    }

    match /leaderboard/{entryId} {
      allow get, list: if true;
      allow create: if isSignedIn() &&
                       isValidId(entryId) &&
                       entryId == request.auth.uid &&
                       incoming().userId == request.auth.uid &&
                       isValidLeaderboard(incoming());
      allow update: if isSignedIn() &&
                       isValidId(entryId) &&
                       entryId == request.auth.uid &&
                       existing().userId == request.auth.uid &&
                       incoming().userId == existing().userId &&
                       isValidLeaderboard(incoming());
      allow delete: if false;
    }

    // --- Air Hockey Multiplayer Rooms ---
    function isValidRoom(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.roomCode is string && data.roomCode.size() <= 8 &&
             data.title is string && data.title.size() <= 60 &&
             data.hostId is string && data.hostId.size() <= 128 &&
             data.hostName is string && data.hostName.size() <= 30 &&
             data.status is string && (data.status in ['waiting', 'playing', 'finished', 'abandoned']) &&
             data.hostScore is number && data.hostScore >= 0 &&
             data.guestScore is number && data.guestScore >= 0 &&
             data.winningScore is number && data.winningScore > 0 &&
             data.createdAt is string && data.createdAt.size() <= 50 &&
             data.updatedAt is string && data.updatedAt.size() <= 50;
    }

    match /rooms/{roomId} {
      allow get, list: if true;
      allow create: if isValidId(roomId) && isValidRoom(incoming());
      allow update: if isValidId(roomId) && isValidRoom(incoming());
      allow delete: if isValidId(roomId);
    }
  }
}
